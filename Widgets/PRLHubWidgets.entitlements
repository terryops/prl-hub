<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Widget extension entitlements. The App Group is the ONLY shared surface with the
  host app: the app writes a non-sensitive snapshot (xpub, public mining address,
  balance, hashrate) here and the widget reads it. No Keychain, no mnemonic.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.prl.wizard</string>
	</array>
</dict>
</plist>
